@startuml c4-context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title C4 Level 1 — Социальная сеть для путешественников

Person(traveler, "Путешественник", "Публикует посты о путешествиях с фотографиями и привязкой к месту, читает общую ленту и ленту подписок, ставит реакции и комментарии, подписывается на других путешественников, ищет популярные места")

System(travelNetwork, "Социальная сеть для путешественников", "Публикация постов с фотографиями и геопривязкой, лента подписок в обратном хронологическом порядке, реакции и комментарии, подписки, поиск популярных мест")

System_Ext(cdn, "CDN", "Раздача превью и фотографий конечным пользователям, offload 95% медиатрафика")

Rel(traveler, travelNetwork, "Публикует посты, читает ленту, ставит реакции и комментарии, управляет подписками, ищет места", "HTTPS / JSON")
Rel(traveler, cdn, "Скачивает превью и фотографии", "HTTPS")
Rel(travelNetwork, cdn, "Отдаёт оригиналы и рендишены при промахе кеша", "HTTPS")

SHOW_LEGEND()
@enduml
